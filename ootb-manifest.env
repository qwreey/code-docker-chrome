# Read by code-docker's ootb.sh/migrate.sh when it wires this project in through
# EXTRA_INCLUDE. Schema: code-docker's docs/tips/ootb-manifest.md. Plain shell env file,
# sourced directly - assignments only, no other code.

OOTB_NAME="Chrome"
OOTB_DESCRIPTION="code-docker에 붙는 Chrome 프로바이더 (labwc + wayvnc, CDP를 토큰으로 감싸 code-docker-internal 너머로 전달)"
OOTB_COMPOSE_INCLUDE="code-docker-chrome.yml"

# router's Dev Proxy / App Routes / VNC tab only accept code-docker and dind as targets
# by default (self-SSRF hardening); anything else is refused with "target host ... is not
# in the allowed target host list" while the stack otherwise comes up fine. chrome-vnc is
# this container's alias on the VNC-only network - the same value as VNC_BIND_ALIAS in
# code-docker-chrome.yml, and it has to match.
#
# Declared here rather than asked about, for the same reason as roblox-studio-docker's:
# only this project knows which hostname it needs, and a boundary allowlist belongs in
# static config rather than the web UI. It also cannot move to a Docker label the way
# netinit's did - router-manager deliberately has no docker.sock to read labels with.
OOTB_ROUTER_ALLOWED_TARGET_HOSTS="chrome-vnc"

# The CDP tunnel's shared secret. Generated rather than prompted: a random value is
# strictly correct here, so asking would only break "install it and it works".
#
# It is a real boundary, not decoration. CDP has no authentication of its own - reaching
# the port is total control of the browser, including reading every cookie of every site
# the profile is logged into. Since chrome-cdp lives on code-docker-internal (see the
# overlay for why a dedicated network was rejected), anything else on that network - a
# container a user started by hand inside dind, say - can reach the port by IP but
# cannot see this token.
OOTB_GENERATE_SECRETS="CHROME_CDP_TOKEN"
