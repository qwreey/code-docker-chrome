# These are read from *code-docker's* .env, not from this directory - this repo has no
# compose file of its own to load an .env for (see code-docker-chrome.yml's header).
# ootb.sh writes CHROME_CDP_TOKEN there for you; the rest are optional overrides.

# Shared secret for the CDP tunnel. Generated by ootb.sh (OOTB_GENERATE_SECRETS).
# cdp-bridge refuses to start if it is empty, on both sides.
CHROME_CDP_TOKEN=

# Headless output resolution. Larger costs VNC bandwidth and Chrome memory.
#CHROME_SCREEN_SIZE=1920x1080

# Page Chrome opens on start.
#CHROME_START_URL=about:blank

# wayvnc-level auth. Off by default: the VNC network is internal: true and shared only
# with router, which fronts it with its own login. Set this to add a second layer.
#VNC_PASSWORD=
