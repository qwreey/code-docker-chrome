{
  "layer": "top",
  "position": "bottom",
  "height": 32,
  "modules-left": ["custom/launcher"],
  "modules-center": ["wlr/taskbar"],
  "modules-right": ["clock"],

  "custom/launcher": {
    "format": "☰ Menu",
    "on-click": "/etc/xdg/labwc/wofi-toggle.sh",
    "tooltip": false
  },

  "wlr/taskbar": {
    "format": "{icon} {title}",
    "icon-size": 16,
    "icon-theme": "hicolor",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },

  "clock": {
    "format": "{:%H:%M}"
  }
}
